<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ярослав Войденко — персональний сайт</title>

<meta name="description" content="Персональний сайт Ярослава Войденка. Медицина, журналістика, освіта та професійний розвиток.">
<meta name="author" content="Ярослав Войденко">
<meta name="theme-color" content="#090a0c">

<meta property="og:title" content="Ярослав Войденко — персональний сайт">
<meta property="og:description" content="Медицина. Журналістика. Ідеї. Розвиток.">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #090a0c;
  --surface: #111316;
  --surface2: #171a1e;
  --text: #f3f1eb;
  --muted: #96999e;
  --gold: #c9a66b;
  --gold-light: #e4c995;
  --border: rgba(255,255,255,.09);
  --header: rgba(9,10,12,.78);
  --shadow: 0 25px 80px rgba(0,0,0,.3);
}

body.light {
  --bg: #f5f3ee;
  --surface: #ffffff;
  --surface2: #eeece6;
  --text: #17191d;
  --muted: #696d73;
  --border: rgba(0,0,0,.10);
  --header: rgba(245,243,238,.82);
  --shadow: 0 25px 80px rgba(0,0,0,.08);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.7;
  overflow-x: hidden;
  transition: background .3s, color .3s;
}

::selection {
  background: var(--gold);
  color: #111;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.container {
  width: min(1160px, 88%);
  margin: auto;
}

.gold {
  color: var(--gold);
}

.muted {
  color: var(--muted);
}

.section {
  padding: 115px 0;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 22px;
}

.section-label::before {
  content: "";
  width: 28px;
  height: 1px;
  background: var(--gold);
}

.section-title {
  font-family: Manrope, sans-serif;
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1.15;
  letter-spacing: -2px;
  font-weight: 700;
  margin-bottom: 25px;
}

.section-description {
  max-width: 620px;
  color: var(--muted);
  font-size: 16px;
}

.gold-line {
  width: 65px;
  height: 2px;
  background: var(--gold);
  margin: 28px 0;
}

/* PRELOADER */

.preloader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #090a0c;
  display: grid;
  place-items: center;
  transition: opacity .7s, visibility .7s;
}

.preloader.hidden {
  opacity: 0;
  visibility: hidden;
}

.loader-logo {
  font-family: Manrope, sans-serif;
  font-size: 48px;
  font-weight: 800;
  letter-spacing: -5px;
  color: var(--gold);
  animation: pulse 1.3s infinite alternate;
}

@keyframes pulse {
  from { opacity: .4; transform: scale(.95); }
  to { opacity: 1; transform: scale(1); }
}

/* PROGRESS */

.progress-bar {
  position: fixed;
  top: 0;
  left: 0;
  height: 2px;
  width: 0%;
  background: var(--gold);
  z-index: 2000;
}

/* HEADER */

header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: var(--header);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}

.nav {
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-family: Manrope, sans-serif;
  font-size: 23px;
  font-weight: 800;
  letter-spacing: -1.5px;
}

.logo span {
  color: var(--gold);
}

.nav-links {
  display: flex;
  gap: 30px;
  align-items: center;
}

.nav-links a {
  color: var(--muted);
  font-size: 13px;
  transition: .25s;
}

.nav-links a:hover {
  color: var(--gold);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}

.theme-btn, .menu-btn {
  width: 39px;
  height: 39px;
  border: 1px solid var(--border);
  border-radius: 50%;
  color: var(--text);
  background: transparent;
  cursor: pointer;
  transition: .25s;
}

.theme-btn:hover, .menu-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.menu-btn {
  display: none;
}

/* HERO */

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  padding: 150px 0 90px;
}

.hero::before {
  content: "";
  position: absolute;
  width: 650px;
  height: 650px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,166,107,.13), transparent 68%);
  right: -150px;
  top: 10%;
  pointer-events: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  align-items: center;
  gap: 70px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--gold);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 3px;
  font-weight: 700;
  margin-bottom: 30px;
}

.eyebrow::before {
  content: "";
  width: 30px;
  height: 1px;
  background: var(--gold);
}

.hero h1 {
  font-family: Manrope, sans-serif;
  font-size: clamp(48px, 7.5vw, 91px);
  line-height: 1.04;
  letter-spacing: -5px;
  font-weight: 800;
}

.hero h1 span {
  color: var(--gold);
}

.hero-subtitle {
  font-size: 18px;
  color: var(--muted);
  margin-top: 30px;
  max-width: 510px;
}

.hero-buttons {
  display: flex;
  gap: 14px;
  margin-top: 38px;
  flex-wrap: wrap;
}

.btn {
  padding: 14px 24px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  transition: .3s;
  cursor: pointer;
}

.btn-primary {
  background: var(--gold);
  color: #111;
  border: 1px solid var(--gold);
}

.btn-primary:hover {
  background: var(--gold-light);
  transform: translateY(-3px);
}

.btn-outline {
  border: 1px solid var(--border);
  color: var(--text);
}

.btn-outline:hover {
  border-color: var(--gold);
  color: var(--gold);
  transform: translateY(-3px);
}

.hero-card {
  min-height: 430px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.monogram {
  width: 320px;
  height: 320px;
  border: 1px solid rgba(201,166,107,.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-family: Manrope, sans-serif;
  font-size: 100px;
  font-weight: 800;
  letter-spacing: -12px;
  color: var(--gold);
  background: radial-gradient(circle, rgba(201,166,107,.08), transparent 70%);
  box-shadow: 0 0 100px rgba(201,166,107,.06);
}

.monogram::before,
.monogram::after {
  content: "";
  position: absolute;
  border: 1px solid rgba(201,166,107,.18);
  border-radius: 50%;
}

.monogram::before {
  inset: -25px;
}

.monogram::after {
  inset: -55px;
}

.orbit {
  position: absolute;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: var(--gold);
  top: 15px;
  right: 55px;
  box-shadow: 0 0 25px var(--gold);
}

.hero-note {
  position: absolute;
  bottom: 20px;
  right: 0;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

/* STATS */

.stats {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 38px 0;
  background: var(--surface);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.stat {
  text-align: center;
  padding: 10px;
}

.stat-number {
  font-family: Manrope, sans-serif;
  color: var(--gold);
  font-size: 34px;
  font-weight: 800;
}

.stat-text {
  color: var(--muted);
  font-size: 12px;
  margin-top: 5px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ABOUT */

.about-grid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 85px;
  align-items: start;
}

.about-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 42px;
  position: relative;
}

.about-panel::after {
  content: "YV";
  position: absolute;
  right: 20px;
  bottom: -35px;
  font-family: Manrope, sans-serif;
  font-size: 100px;
  font-weight: 800;
  color: rgba(201,166,107,.07);
}

.about-panel h3 {
  font-family: Manrope, sans-serif;
  font-size: 24px;
  margin-bottom: 18px;
}

.about-panel p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 15px;
}

.about-text p {
  color: var(--muted);
  margin-bottom: 20px;
  font-size: 15px;
}

.about-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-top: 32px;
}

.detail {
  border-top: 1px solid var(--border);
  padding-top: 15px;
}

.detail small {
  color: var(--muted);
  display: block;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.detail strong {
  display: block;
  margin-top: 5px;
  font-size: 14px;
}

/* DIRECTIONS */

.directions {
  background: var(--surface);
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 55px;
}

.direction-card {
  border: 1px solid var(--border);
  padding: 35px;
  min-height: 280px;
  background: var(--bg);
  transition: .35s;
  position: relative;
  overflow: hidden;
}

.direction-card:hover {
  transform: translateY(-8px);
  border-color: var(--gold);
  box-shadow: var(--shadow);
}

.card-number {
  font-family: Manrope, sans-serif;
  font-size: 13px;
  color: var(--gold);
  letter-spacing: 2px;
}

.card-icon {
  font-size: 30px;
  margin: 28px 0 18px;
}

.direction-card h3 {
  font-family: Manrope, sans-serif;
  font-size: 23px;
  margin-bottom: 12px;
}

.direction-card p {
  color: var(--muted);
  font-size: 13px;
}

/* JOURNALISM */

.journalism-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.media-card {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 45px;
  position: relative;
  overflow: hidden;
}

.media-card::after {
  content: "MEDIA";
  position: absolute;
  right: -10px;
  bottom: -35px;
  font-family: Manrope, sans-serif;
  font-size: 85px;
  font-weight: 800;
  color: rgba(201,166,107,.06);
}

.media-logo {
  font-family: Manrope, sans-serif;
  font-weight: 800;
  font-size: 48px;
  letter-spacing: -3px;
  color: var(--text);
}

.media-logo span {
  color: var(--gold);
}

.media-caption {
  color: var(--muted);
  font-size: 12px;
  margin-top: 5px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.article-card {
  margin-top: 30px;
  border-top: 1px solid var(--border);
  padding-top: 25px;
}

.article-card h3 {
  font-size: 20px;
  font-family: Manrope, sans-serif;
  margin: 12px 0;
}

.article-card p {
  color: var(--muted);
  font-size: 13px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--gold);
  font-size: 13px;
  font-weight: 700;
  margin-top: 20px;
  transition: .2s;
}

.text-link:hover {
  gap: 16px;
}

/* TIMELINE */

.timeline {
  max-width: 760px;
  margin-top: 55px;
  position: relative;
}

.timeline::before {
  content: "";
  position: absolute;
  top: 8px;
  bottom: 0;
  left: 7px;
  width: 1px;
  background: var(--border);
}

.timeline-item {
  position: relative;
  padding-left: 45px;
  padding-bottom: 45px;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 2px;
  top: 7px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 15px rgba(201,166,107,.4);
}

.timeline-item small {
  color: var(--gold);
  letter-spacing: 2px;
  font-size: 11px;
  text-transform: uppercase;
}

.timeline-item h3 {
  font-family: Manrope, sans-serif;
  font-size: 21px;
  margin: 8px 0;
}

.timeline-item p {
  color: var(--muted);
  font-size: 14px;
}

/* PRINCIPLES */

.principles {
  background: var(--surface);
}

.principle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin-top: 50px;
}

.principle {
  background: var(--surface);
  padding: 35px;
}

.principle span {
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 2px;
}

.principle h3 {
  font-family: Manrope, sans-serif;
  font-size: 22px;
  margin: 13px 0;
}

.principle p {
  color: var(--muted);
  font-size: 13px;
}

/* CONTACT */

.contact-box {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 65px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.contact-box::before {
  content: "";
  position: absolute;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,166,107,.1), transparent 70%);
  top: -200px;
  left: 50%;
  transform: translateX(-50%);
}

.contact-box .section-title {
  position: relative;
}

.contact-box p {
  color: var(--muted);
  max-width: 550px;
  margin: 0 auto;
}

.email-copy {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 15px 20px;
  border: 1px solid var(--border);
  margin-top: 30px;
  color: var(--gold);
  background: transparent;
  cursor: pointer;
  font-size: 14px;
  transition: .25s;
}

.email-copy:hover {
  border-color: var(--gold);
  background: rgba(201,166,107,.06);
}

.contact-buttons {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 25px;
}

/* FOOTER */

footer {
  border-top: 1px solid var(--border);
  padding: 35px 0;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.footer-name {
  font-family: Manrope, sans-serif;
  font-size: 17px;
  font-weight: 800;
}

.footer-name span {
  color: var(--gold);
}

.footer-copy {
  color: var(--muted);
  font-size: 11px;
}

.footer-top {
  color: var(--gold);
  font-size: 12px;
}

/* TOAST */

.toast {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translate(-50%, 20px);
  background: var(--gold);
  color: #111;
  padding: 12px 22px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  opacity: 0;
  visibility: hidden;
  transition: .3s;
  z-index: 3000;
}

.toast.show {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}

/* BACK TO TOP */

.back-top {
  position: fixed;
  right: 25px;
  bottom: 25px;
  width: 43px;
  height: 43px;
  background: var(--gold);
  color: #111;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transition: .3s;
  z-index: 900;
}

.back-top.visible {
  opacity: 1;
  visibility: visible;
}

/* REVEAL */

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity .8s ease, transform .8s ease;
}

.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

/* MOBILE */

@media(max-width: 900px) {
  .hero-grid,
  .about-grid,
  .journalism-grid {
    grid-template-columns: 1fr;
  }

  .hero-card {
    min-height: 350px;
  }

  .monogram {
    width: 240px;
    height: 240px;
    font-size: 75px;
  }

  .cards-grid {
    grid-template-columns: 1fr 1fr;
  }

  .about-grid {
    gap: 45px;
  }
}

@media(max-width: 650px) {
  .container {
    width: 89%;
  }

  .section {
    padding: 80px 0;
  }

  .nav {
    height: 68px;
  }

  .menu-btn {
    display: block;
  }

  .nav-links {
    position: absolute;
    top: 68px;
    left: 0;
    width: 100%;
    padding: 25px 6%;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .nav-links.open {
    display: flex;
  }

  .hero {
    padding-top: 125px;
  }

  .hero h1 {
    letter-spacing: -3px;
  }

  .hero-subtitle {
    font-size: 15px;
  }

  .hero-card {
    min-height: 300px;
  }

  .monogram {
    width: 190px;
    height: 190px;
    font-size: 62px;
  }

  .monogram::before {
    inset: -17px;
  }

  .monogram::after {
    inset: -35px;
  }

  .hero-note {
    right: 10px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .stat-number {
    font-size: 28px;
  }

  .cards-grid,
  .principle-grid {
    grid-template-columns: 1fr;
  }

  .about-panel,
  .media-card {
    padding: 28px;
  }

  .about-details {
    grid-template-columns: 1fr 1fr;
  }

  .contact-box {
    padding: 40px 22px;
  }

  .email-copy {
    font-size: 12px;
    padding: 12px;
  }

  .footer-content {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media(prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
</style>
</head>

<body>

<div class="preloader" id="preloader">
  <div class="loader-logo">YV.</div>
</div>

<div class="progress-bar" id="progress"></div>

<header>
  <div class="container nav">

    <a href="#home" class="logo">Y<span>V.</span></a>

    <nav class="nav-links" id="navLinks">
      <a href="#about">Про мене</a>
      <a href="#directions">Напрями</a>
      <a href="#journalism">Журналістика</a>
      <a href="#education">Освіта</a>
      <a href="#contact">Контакти</a>
    </nav>

    <div class="nav-actions">
      <button class="theme-btn" id="themeToggle" aria-label="Змінити тему">☼</button>
      <button class="menu-btn" id="menuToggle" aria-label="Відкрити меню">☰</button>
    </div>

  </div>
</header>

<main>

<!-- HERO -->

<section class="hero" id="home">
  <div class="container hero-grid">

    <div class="hero-content reveal">
      <div class="eyebrow">Personal website · 2026</div>

      <h1>
        Ярослав<br>
        <span>Войденко.</span>
      </h1>

      <p class="hero-subtitle">
        Медицина, журналістика та прагнення створювати
        змістовні речі, які мають значення.
      </p>

      <div class="hero-buttons">
        <a href="#about" class="btn btn-primary">
          Познайомитися <span>↗</span>
        </a>

        <a href="#journalism" class="btn btn-outline">
          Мої публікації
        </a>
